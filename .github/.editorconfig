# EditorConfig settings for the files in this directory.
#
# `root = false` keeps the search for a parent .editorconfig file running, so
# the repository root file stays authoritative for the rest of the tree.
#
# The repository root carries the same settings for the package sources, the
# tests and the documentation.

root = false

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
